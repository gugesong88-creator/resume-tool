# Optional. Keep the real webhook in your shell environment or a local .env file.
FEISHU_WEBHOOK=

# The server is intentionally local-only by default.
HOST=127.0.0.1
PORT=8000

# Optional: point tests or packaged builds at a separate data directory.
# RESUME_DATA_DIR=/absolute/path/to/resume-data

# Opt in only when Chromium cannot start with its sandbox enabled.
PUPPETEER_NO_SANDBOX=0
