{
  "name": "local-resume-builder",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "repo:check": "node scripts/check-repository.js",
    "check": "node scripts/check-syntax.js && npm run typecheck",
    "test": "node --test \"test/*.test.js\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 e2e/app.test.js",
    "verify": "npm run check && npm test && npm run build",
    "ci": "npm run repo:check && npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "puppeteer": "^25.8.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
